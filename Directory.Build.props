<Project>
  <PropertyGroup>
    <KitVersion Condition="'$(KitVersion)' == ''">10.0.28000.1839</KitVersion>
    <PackagesDir>$(MSBuildThisFileDirectory)packages\</PackagesDir>
  </PropertyGroup>
  <Import Project="$(PackagesDir)Microsoft.Windows.WDK.x64.$(KitVersion)\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(PackagesDir)Microsoft.Windows.WDK.x64.$(KitVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(PackagesDir)Microsoft.Windows.SDK.CPP.x64.$(KitVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(PackagesDir)Microsoft.Windows.SDK.CPP.x64.$(KitVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(PackagesDir)Microsoft.Windows.SDK.CPP.$(KitVersion)\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(PackagesDir)Microsoft.Windows.SDK.CPP.$(KitVersion)\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
