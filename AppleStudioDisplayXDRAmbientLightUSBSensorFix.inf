[Version]
Signature = "$WINDOWS NT$"
Class = HIDClass
ClassGuid = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider = %Provider%
CatalogFile = AppleStudioDisplayXDRAmbientLightUSBSensorFix.cat
DriverVer = 07/27/2026, 1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
AppleStudioDisplayXDRAmbientLightUSBSensorFix.sys = 1

[Manufacturer]
%Provider% = Std, NTamd64.10.0...16299

[Std.NTamd64.10.0...16299]
%AmbientLightUSBSensor% = Fix, USB\VID_05AC&PID_1116&MI_08

[Fix.NT]
Include = input.inf
Needs = HID_Inst.NT
CopyFiles = Fix_CopyFiles

[Fix.NT.HW]
Include = input.inf
Needs = HID_Inst.NT.HW
AddReg = Fix_AddReg

[Fix.NT.Services]
Include = input.inf
Needs = HID_Inst.NT.Services
AddService = AppleStudioDisplayXDRAmbientLightUSBSensorFix, , Fix_Service

[Fix.NT.Wdf]
KmdfService = AppleStudioDisplayXDRAmbientLightUSBSensorFix, Fix_WdfSect

[Fix_AddReg]
HKR, , "LowerFilters", 0x00010008, "AppleStudioDisplayXDRAmbientLightUSBSensorFix"

[Fix_CopyFiles]
AppleStudioDisplayXDRAmbientLightUSBSensorFix.sys

[Fix_Service]
DisplayName = %ServiceDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\AppleStudioDisplayXDRAmbientLightUSBSensorFix.sys

[Fix_WdfSect]
KmdfLibraryVersion = 1.15

[Strings]
Provider = "Alexey Rodionov"
DiskName = "Apple Studio Display XDR Ambient Light USB Sensor Fix Installation Disk"
ServiceDisplayName = "Apple Studio Display XDR Ambient Light USB Sensor Fix"
AmbientLightUSBSensor = "Apple Studio Display XDR USB Ambient Light Sensor"
